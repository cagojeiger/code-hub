    "service",
    "codehub"
  ],
  "schemaVersion": 40,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/codehub-overview",
      "tooltip": "System Overview",
