      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "asDropdown": false
    },
    {
      "title": "CP Service",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/codehub-cp-service",
      "tooltip": "Control Plane Service",
      "targetBlank": false,
      "includeVars": false,
